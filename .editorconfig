root = true

[*.cs]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

# C# style
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion
csharp_preserve_single_line_blocks = false

dotnet_sort_system_directives_first = true

[*.{yml,yaml,json,md}]
indent_size = 2
indent_style = space
end_of_line = lf
